    ob_ln(ob, "  --bg-btn-dim: #0a0a0d;");
    ob_ln(ob, "  --border-dim: #22222a;");
    ob_ln(ob, "  --border-subtle: #2b2b36;");
    ob_ln(ob, "  --border-card: #2f2f3b;");
    ob_ln(ob, "  --border-hover: #4e4e60;");
    ob_ln(ob, "  --border-bold: #e0e0e6;");
    ob_ln(ob, "  --border-dashed: #444455;");
    ob_ln(ob, "  --text-main: #e2e2e8;");
    ob_ln(ob, "  --text-muted: #9494a3;");
    ob_ln(ob, "  --text-dim: #6c6c7b;");
