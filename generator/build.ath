    ob_ln(ob, ".cat-pill.active { background: var(--bg-card-hover); border-color: var(--border-bold); color: var(--text-head); }");
    ob_ln(ob, ".bundle-box { background: var(--bg-card); border: 1px solid var(--border-card); padding: 22px 24px; margin: 18px 0 24px; }");
