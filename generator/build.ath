// website/build.ath — Pure-Atherium static site generator for ATHERIUM / .ath
// Generates monochrome HTML + CSS + GitHub live auto-sync JS + local mirrors for
// .athlib libraries, .athplugin language packs, .aththeme themes, and Studio downloads.
// Run: ./Atherium/build/atherium run --allow-io --mem 32M --lib Atherium/lib --lib website/lib website/build.ath

use alloc;
use html;

const REPO_URL: str        = "https://github.com/Deadstillplays/Atherium";
const STUDIO_REPO_URL: str = "https://github.com/Deadstillplays/AtheriumStudio";
const STUDIO_APPIMAGE: str = "https://github.com/Deadstillplays/AtheriumStudio/raw/main/AtheriumStudio-x86_64.AppImage";
const STUDIO_EXE: str      = "https://github.com/Deadstillplays/AtheriumStudio/raw/main/AtheriumStudio-x86_64.exe";
const RAW_ATH_BASE: str    = "https://raw.githubusercontent.com/Deadstillplays/Atherium/main/";
const RAW_STU_BASE: str    = "https://raw.githubusercontent.com/Deadstillplays/AtheriumStudio/main/";

fn str_addr(s: int) -> int { return s; }

fn ends_with_ext(ptr: int, n: int, ext: str) -> int {
    let el: int = str_len(ext);
    if (n < el) { return 0; }
    let ep: int = str_addr(ext);
    for (let i: int = 0; i < el; i += 1) {
        if (load8(ptr + n - el + i) != load8(ep + i)) { return 0; }
    }
    return 1;
}

fn count_fns(buf: int, n: int) -> int {
    let cnt: int = 0;
    let at_sol: int = 1;
    for (let i: int = 0; i < n; i += 1) {
        let c: int = load8(buf + i);
        if (at_sol && i + 2 < n && c == 102 && load8(buf + i + 1) == 110 && load8(buf + i + 2) == 32) {
            cnt += 1;
        }
        if (c == 10) { at_sol = 1; } else { at_sol = 0; }
    }
    return cnt;
}

// Extract description from first line `// name.athlib — <desc>`
fn emit_lib_desc(ob: int, buf: int, n: int) {
    let eol: int = 0;
    while (eol < n && load8(buf + eol) != 10 && load8(buf + eol) != 13) {
        eol += 1;
    }
    if (eol < 3 || load8(buf) != 47 || load8(buf + 1) != 47) {
        ob_s(ob, "Pure-Atherium standard library module");
        return;
    }
    let start: int = 2;
    while (start < eol && load8(buf + start) == 32) { start += 1; }
    for (let i: int = start; i + 2 < eol; i += 1) {
        if (load8(buf + i) == 226 && load8(buf + i + 1) == 128 && load8(buf + i + 2) == 148) {
            start = i + 3;
            while (start < eol && load8(buf + start) == 32) { start += 1; }
            break;
        }
    }
    if (start < eol) {
        ob_esc_raw(ob, buf + start, eol - start);
    } else {
        ob_s(ob, "Pure-Atherium standard library module");
    }
}

// Extract `key=value` from an ini-style .athplugin / .aththeme buffer into ob
fn emit_kv_field(ob: int, buf: int, n: int, key: str, fallback: str) -> int {
    let kl: int = str_len(key);
    let kp: int = str_addr(key);
    let pos: int = 0;
    while (pos < n) {
        let eol: int = pos;
        while (eol < n && load8(buf + eol) != 10) { eol += 1; }
        let lend: int = eol;
        if (lend > pos && load8(buf + lend - 1) == 13) { lend -= 1; }
        if (lend - pos > kl + 1 && load8(buf + pos + kl) == 61) {
            let ok: int = 1;
            for (let k: int = 0; k < kl; k += 1) {
                if (load8(buf + pos + k) != load8(kp + k)) { ok = 0; break; }
            }
            if (ok) {
                let v0: int = pos + kl + 1;
                while (v0 < lend && load8(buf + v0) == 32) { v0 += 1; }
                if (v0 < lend) {
                    ob_esc_raw(ob, buf + v0, lend - v0);
                    return 1;
                }
            }
        }
        pos = eol + 1;
    }
    if (str_len(fallback) > 0) { ob_s(ob, fallback); }
    return 0;
}

fn emit_css(ob: int) {
