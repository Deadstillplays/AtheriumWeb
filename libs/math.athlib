// math.athlib — integer math helpers written in Atherium.
// sin, cos, sqrt, fabs are builtins that lower to the float opcodes
// FSIN / FCOS / FSQRT / FABS.

fn absi(x: int) -> int {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

fn mini(a: int, b: int) -> int {
    if (a < b) {
        return a;
    }
    return b;
}

fn maxi(a: int, b: int) -> int {
    if (a > b) {
        return a;
    }
    return b;
}

fn clampi(x: int, lo: int, hi: int) -> int {
    if (x < lo) {
        return lo;
    }
    if (x > hi) {
        return hi;
    }
    return x;
}

fn powi(base: int, e: int) -> int {
    let r: int = 1;
    let b: int = base;
    let p: int = e;
    while (p > 0) {
        if ((p & 1) != 0) {
            r = r * b;
        }
        b = b * b;
        p = p >> 1;
    }
    return r;
}

fn modpow(base: int, e: int, m: int) -> int {
    if (m <= 1) {
        return 0;
    }
    let r: int = 1;
    let b: int = base % m;
    if (b < 0) {
        b = b + m;
    }
    let p: int = e;
    while (p > 0) {
        if ((p & 1) != 0) {
            r = (r * b) % m;
        }
        b = (b * b) % m;
        p = p >> 1;
    }
    return r;
}

fn gcd(a: int, b: int) -> int {
    let x: int = absi(a);
    let y: int = absi(b);
    while (y != 0) {
        let t: int = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn lcm(a: int, b: int) -> int {
    if (a == 0 || b == 0) {
        return 0;
    }
    let g: int = gcd(a, b);
    return (absi(a) / g) * absi(b);
}

fn isqrt(n: int) -> int {
    if (n <= 0) {
        return 0;
    }
    let x: int = to_int(sqrt(to_float(n)));
    if (x < 0) {
        x = 0;
    }
    if (x > 3037000499) {
        x = 3037000499;
    }
    while (x < 3037000499 && (x + 1) * (x + 1) <= n) {
        x = x + 1;
    }
    while (x * x > n) {
        x = x - 1;
    }
    return x;
}

fn popcount(v: int) -> int {
    let x: int = v;
    x = x - ((x >>> 1) & 0x5555555555555555);
    x = (x & 0x3333333333333333) + ((x >>> 2) & 0x3333333333333333);
    x = (x + (x >>> 4)) & 0x0F0F0F0F0F0F0F0F;
    return (x * 0x0101010101010101) >>> 56;
}

fn log2i(n: int) -> int {
    if (n <= 1) {
        return 0;
    }
    let r: int = 0;
    let x: int = n;
    if ((x >> 32) != 0) { x = x >> 32; r = r + 32; }
    if ((x >> 16) != 0) { x = x >> 16; r = r + 16; }
    if ((x >> 8) != 0)  { x = x >> 8;  r = r + 8;  }
    if ((x >> 4) != 0)  { x = x >> 4;  r = r + 4;  }
    if ((x >> 2) != 0)  { x = x >> 2;  r = r + 2;  }
    if ((x >> 1) != 0)  { r = r + 1; }
    return r;
}

fn minf(a: float, b: float) -> float {
    if (a < b) {
        return a;
    }
    return b;
}

fn maxf(a: float, b: float) -> float {
    if (a > b) {
        return a;
    }
    return b;
}

fn clampf(x: float, lo: float, hi: float) -> float {
    if (x < lo) {
        return lo;
    }
    if (x > hi) {
        return hi;
    }
    return x;
}

fn lerp(a: float, b: float, t: float) -> float {
    return a + (b - a) * t;
}

fn fib(n: int) -> int {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
